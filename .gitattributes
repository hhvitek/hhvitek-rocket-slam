# Normalise text files to LF
* text=auto eol=lf

# Unity YAML (scenes, prefabs, assets): text, merged as text
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.meta      text eol=lf
*.controller text eol=lf
*.anim      text eol=lf
*.inputactions text eol=lf
*.uxml      text eol=lf
*.uss       text eol=lf
*.cs        text eol=lf diff=csharp
*.py        text eol=lf diff=python
*.json      text eol=lf
*.md        text eol=lf diff=markdown
*.tss       text eol=lf
*.asmdef    text eol=lf
*.shadergraph text eol=lf

# Binary assets (no diff, no line-ending conversion)
*.blend binary
*.fbx   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.exr   binary
*.hdr   binary
*.tga   binary
*.psd   binary
*.wav   binary
*.ogg   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.webm  binary
*.so    binary
*.dll   binary
