/* Menus, level select, settings, pause and results. Same palette as Hud.uss: dark panels, yellow accents. */

.menu-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(235, 240, 245);
    font-size: 26px;
}

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
}
.screen.open { display: flex; }

.screen-title {
    font-size: 54px;
    -unity-font-style: bold;
    color: rgb(255, 210, 60);
    letter-spacing: 4px;
    margin-bottom: 18px;
}

.menu-hint {
    font-size: 20px;
    color: rgb(160, 175, 190);
    margin-top: 18px;
}

/* ---- buttons (VisualElements driven by MenuList) ---- */
.menu-list { margin-top: 16px; }
.menu-button {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 12px 26px;
    margin: 7px 0;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}
.menu-button-text { font-size: 38px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(235, 240, 245); }
.menu-button-sub { font-size: 21px; color: rgb(160, 175, 190); margin-top: 2px; }
.menu-button.selected {
    background-color: rgba(255, 210, 60, 0.95);
    border-color: rgb(255, 230, 140);
    translate: 10px 0;
}
.menu-button.selected .menu-button-text { color: rgb(16, 18, 22); }
.menu-button.selected .menu-button-sub { color: rgb(60, 50, 20); }
.menu-button.disabled { opacity: 0.35; }

/* ---- main screen ---- */
.main-screen { flex-direction: row; }
.main-panel {
    width: 720px;
    height: 100%;
    padding: 56px 70px 50px 90px;
    background-color: rgba(8, 11, 16, 0.78);
    border-right-width: 2px;
    border-color: rgba(255, 210, 60, 0.35);
}
.game-title { font-size: 118px; -unity-font-style: bold; color: rgb(255, 210, 60); letter-spacing: 8px; }
.game-title-2 { margin-top: -34px; color: rgb(235, 240, 245); }
.game-tagline { font-size: 28px; color: rgb(200, 210, 220); margin-top: -6px; margin-bottom: 18px; }
.play-button .menu-button-text { font-size: 48px; }
.progress-row { flex-direction: row; align-items: center; margin-top: 30px; }
.progress-star { width: 40px; height: 40px; margin-right: 10px; }
.progress-text { font-size: 28px; -unity-font-style: bold; color: rgb(255, 210, 60); }
.main-panel .menu-hint { position: absolute; bottom: 44px; left: 90px; }

/* ---- level select ---- */
.levels-screen {
    background-color: rgba(5, 8, 12, 0.72);
    align-items: center;
    justify-content: center;
}
.level-cards { flex-direction: row; justify-content: center; }
.level-card {
    width: 318px;
    height: 520px;
    margin: 0 10px;
    padding: 22px 22px 18px 22px;
    background-color: rgba(10, 14, 20, 0.92);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    transition-property: border-color, translate, background-color;
    transition-duration: 0.12s;
}
.level-card.selected {
    border-color: rgb(255, 210, 60);
    background-color: rgba(30, 30, 22, 0.95);
    translate: 0 -12px;
}
.card-number { font-size: 22px; -unity-font-style: bold; color: rgb(140, 210, 255); letter-spacing: 3px; }
.card-name { font-size: 38px; -unity-font-style: bold; margin-top: 2px; white-space: normal; }
.card-site { font-size: 22px; color: rgb(255, 210, 60); -unity-font-style: bold; margin-top: 10px; }
.card-conditions { font-size: 22px; color: rgb(215, 222, 230); white-space: normal; margin-top: 6px; height: 64px; }
.card-fuel { font-size: 22px; color: rgb(160, 175, 190); margin-top: 6px; }
.card-divider { height: 2px; background-color: rgba(255, 255, 255, 0.12); margin: 16px 0 12px 0; }
.card-best-label { font-size: 18px; color: rgb(160, 175, 190); letter-spacing: 2px; }
.card-best { font-size: 44px; -unity-font-style: bold; }
.card-stars { flex-direction: row; margin-top: 8px; }
.card-stars .star { width: 54px; height: 54px; margin-right: 6px; }
.card-lock {
    position: absolute; left: 0; top: 156px; right: 0; bottom: 0;
    background-color: rgb(13, 17, 23);
    border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;
    border-top-width: 2px; border-color: rgba(255, 255, 255, 0.1);
    align-items: center; justify-content: center;
    display: none;
}
.level-card.locked .card-lock { display: flex; }
.level-card.locked .card-number, .level-card.locked .card-name, .level-card.locked .card-site { opacity: 0.55; }
.lock-title { font-size: 36px; -unity-font-style: bold; color: rgb(160, 175, 190); letter-spacing: 4px; }
.lock-note { font-size: 22px; color: rgb(160, 175, 190); margin-top: 6px; white-space: normal; -unity-text-align: middle-center; padding: 0 16px; }
.lock-icon { width: 46px; height: 36px; border-width: 5px; border-color: rgb(160, 175, 190); border-radius: 6px; margin-bottom: 12px; }
.lock-shackle {
    position: absolute; left: 6px; top: -30px; width: 24px; height: 28px;
    border-top-width: 5px; border-left-width: 5px; border-right-width: 5px;
    border-color: rgb(160, 175, 190); border-top-left-radius: 12px; border-top-right-radius: 12px;
}
.levels-hint { margin-top: 34px; font-size: 24px; }

/* ---- settings ---- */
.settings-host { align-items: center; justify-content: center; background-color: rgba(5, 8, 12, 0.6); }
.settings-panel { flex-grow: 1; align-items: center; justify-content: center; }
.settings-box {
    width: 1120px;
    padding: 34px 50px 30px 50px;
    background-color: rgba(10, 14, 20, 0.94);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 16px;
}
.setting-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 22px;
    margin: 5px 0;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(255, 255, 255, 0.04);
}
.setting-row.selected { border-color: rgb(255, 210, 60); background-color: rgba(255, 210, 60, 0.12); }
.setting-name { width: 360px; font-size: 30px; -unity-font-style: bold; letter-spacing: 2px; }
.setting-value { flex-grow: 1; flex-direction: row; align-items: center; }
.chips { flex-direction: row; }
.chip {
    font-size: 26px; -unity-font-style: bold; letter-spacing: 2px;
    padding: 8px 22px; margin-right: 12px;
    border-radius: 8px; border-width: 2px; border-color: rgba(255, 255, 255, 0.18);
    color: rgb(160, 175, 190);
    background-color: rgba(255, 255, 255, 0.04);
}
.chip:hover { border-color: rgba(255, 255, 255, 0.5); }
.chip.chip-on { background-color: rgb(255, 210, 60); color: rgb(16, 18, 22); border-color: rgb(255, 230, 140); }
.volume-slider { flex-grow: 1; margin-right: 20px; }
.volume-value { width: 110px; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-right; }
.settings-hint { font-size: 21px; color: rgb(160, 175, 190); margin: 14px 4px 4px 4px; height: 56px; white-space: normal; }
.back-button { align-self: flex-start; padding: 10px 40px; }
.back-button .menu-button-text { font-size: 32px; }

/* slider look */
.volume-slider #unity-tracker {
    height: 10px; margin-top: -5px;
    background-color: rgba(255, 255, 255, 0.18); border-width: 0; border-radius: 5px;
}
.volume-slider #unity-dragger {
    width: 26px; height: 26px; margin-top: -13px; margin-left: -13px;
    border-radius: 13px; border-width: 0;
    background-color: rgb(255, 210, 60);
}
.volume-slider #unity-dragger-border { display: none; }

/* ---- pause ---- */
.pause-screen { align-items: center; justify-content: center; background-color: rgba(5, 8, 12, 0.55); }
.pause-box {
    width: 640px;
    padding: 36px 54px 30px 54px;
    background-color: rgba(10, 14, 20, 0.92);
    border-width: 2px; border-color: rgba(255, 255, 255, 0.2); border-radius: 16px;
}
.pause-level { font-size: 26px; color: rgb(140, 210, 255); -unity-font-style: bold; margin-top: -8px; }
.pause-box .menu-list { margin-top: 16px; }

/* ---- results ---- */
.results-screen { align-items: center; justify-content: center; background-color: rgba(5, 8, 12, 0.45); }
.results-box {
    width: 1640px;
    padding: 30px 44px 28px 44px;
    background-color: rgba(10, 14, 20, 0.93);
    border-width: 2px; border-color: rgba(255, 255, 255, 0.2); border-radius: 18px;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}
.results-box.hidden-anim { opacity: 0; translate: 0 40px; }
.results-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.results-heading { flex-shrink: 1; }
.results-title { font-size: 76px; -unity-font-style: bold; letter-spacing: 3px; }
.results-title.good { color: rgb(110, 230, 120); }
.results-title.danger { color: rgb(255, 90, 80); }
.results-reason { font-size: 28px; margin-top: -2px; }
.results-level { font-size: 28px; -unity-font-style: bold; color: rgb(140, 210, 255); margin-top: 20px; }
.results-tip { font-size: 26px; color: rgb(255, 210, 60); margin-top: 8px; white-space: normal; }
.results-body { flex-direction: row; margin-top: 22px; }

.score-column { width: 560px; margin-right: 40px; }
.score-row { flex-direction: row; align-items: flex-end; margin-top: 8px; }
.score-name { width: 190px; font-size: 26px; -unity-font-style: bold; letter-spacing: 2px; color: rgb(200, 210, 220); }
.score-detail { flex-grow: 1; font-size: 21px; color: rgb(160, 175, 190); padding-bottom: 2px; }
.score-value { width: 90px; font-size: 34px; -unity-font-style: bold; -unity-text-align: lower-right; }
.score-bar { height: 10px; background-color: rgba(255, 255, 255, 0.1); border-radius: 4px; margin-top: 4px; overflow: hidden; }
.score-bar-fill { height: 100%; width: 0; background-color: rgb(255, 210, 60); border-radius: 4px; }
.score-total-row { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-top: 18px; border-top-width: 2px; border-color: rgba(255, 255, 255, 0.15); padding-top: 8px; }
.score-total-name { font-size: 34px; -unity-font-style: bold; letter-spacing: 3px; padding-bottom: 8px; }
.score-total { font-size: 76px; -unity-font-style: bold; color: rgb(255, 210, 60); }
.stars-row { flex-direction: row; align-items: center; margin-top: 6px; }
.stars { flex-direction: row; }
.stars .star { width: 84px; height: 84px; margin-right: 10px; }
.new-best {
    font-size: 30px; -unity-font-style: bold; letter-spacing: 2px;
    color: rgb(16, 18, 22); background-color: rgb(110, 230, 120);
    padding: 6px 16px; border-radius: 8px; margin-left: 16px;
    display: none;
}
.new-best.visible { display: flex; }
.best-line { font-size: 22px; color: rgb(160, 175, 190); margin-top: 8px; }

.graph-column { flex-grow: 1; }
.graph-head { flex-direction: row; justify-content: space-between; align-items: center; }
.graph-title { font-size: 22px; -unity-font-style: bold; letter-spacing: 3px; color: rgb(140, 160, 180); }
.legend { flex-direction: row; }
.legend-item { flex-direction: row; align-items: center; margin-left: 22px; }
.legend-swatch { width: 26px; height: 6px; border-radius: 3px; margin-right: 8px; }
.swatch-alt { background-color: rgb(92, 199, 255); }
.swatch-fall { background-color: rgb(255, 107, 92); }
.swatch-thrust { background-color: rgb(255, 199, 51); }
.legend-text { font-size: 20px; color: rgb(215, 222, 230); }
.graph-host {
    height: 410px; margin-top: 10px;
    background-color: rgba(255, 255, 255, 0.035);
    border-radius: 10px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.telemetry-graph { flex-grow: 1; }
.graph-tick { position: absolute; width: 60px; font-size: 17px; color: rgb(160, 175, 190); -unity-text-align: upper-center; }

.results-buttons { flex-direction: row; justify-content: center; margin-top: 24px; }
.row-button { flex-direction: row; align-items: center; margin: 0 12px; padding: 12px 30px; }
.row-button .menu-button-text { font-size: 34px; }
.row-button.selected { translate: 0 -4px; }
.key-cap {
    font-size: 20px; -unity-font-style: bold; margin-left: 16px;
    padding: 2px 10px; border-radius: 6px; border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35); color: rgb(200, 210, 220);
}
.row-button.selected .key-cap { border-color: rgba(16, 18, 22, 0.6); color: rgb(16, 18, 22); }
